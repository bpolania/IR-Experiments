{
  "task_name": "hex_encode",
  "abi": {
    "function": "f",
    "signature_ir": "i32 @f(i8* %in_ptr, i32 %in_len, i8* %out_ptr, i32 %out_cap)"
  },
  "return_semantics": "Returns bytes written on success; negative error code on failure.",
  "memory_rules": {
    "input_immutable": true,
    "no_overlap": true,
    "no_alignment_assumptions": true,
    "no_output_writes_on_error": true
  },
  "task_rules": [
    "Encode each input byte as two lowercase hexadecimal ASCII characters.",
    "Output length is exactly 2 * in_len bytes.",
    "Return 2 * in_len on success."
  ],
  "errors": {
    "ERR_INVALID_INPUT": -1,
    "ERR_OUTPUT_TOO_SMALL": -2,
    "ERR_INTERNAL": -3
  },
  "output_cap_rule": "Require out_cap >= 2 * in_len for success.",
  "output_encoding": "Lowercase hexadecimal ASCII bytes"
}
