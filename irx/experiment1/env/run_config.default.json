{
  "experiment": "1",
  "target_triple": "aarch64-unknown-linux-gnu",
  "limits": {
    "max_ll_bytes": 65536,
    "max_ll_lines": 2000,
    "max_basic_blocks": 200,
    "max_instructions": 20000,
    "max_alloca_bytes_total": 4096,
    "timeout_stage_ms": 1000,
